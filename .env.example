# Bot Token
BOT_TOKEN=your_telegram_bot_token_here

# Database Configuration
# docker-compose: set the three vars below; compose builds DATABASE_URL automatically.
# Render: DATABASE_URL is injected from the managed Postgres (see render.yaml).
# Running outside Docker: set DATABASE_URL directly instead.
DATABASE_USER=postgres
DATABASE_PASSWORD=your_database_password
DATABASE_NAME=dating_popcorn
#DATABASE_URL=postgresql://user:password@localhost:5432/dating_popcorn

# AWS Configuration
AWS_ACCESS_KEY_ID=your_aws_access_id
AWS_SECRET_ACCESS_KEY=your_aws_access_key
AWS_REGION=your_aws_region
S3_BUCKET_NAME=your_aws_bucket_name

# Cloudflare Worker (serves S3 images)
CLOUDFLARE_WORKER_URL=https://your-worker.your-subdomain.workers.dev

# Security
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=your_jwt_secret_key
